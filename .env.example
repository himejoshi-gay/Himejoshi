# General settings

# Required: The domain where the web application is hosted
WEB_DOMAIN=sunrise.local

# Required: Secret key for API token generation. REPLACE WITH ANY RANDOM STRING FOR PRODUCTION !
API_TOKEN_SECRET=SunnyMountainRiver

# Registration verification. Production defaults to requiring Discord when this is omitted.
REQUIRE_DISCORD_REGISTRATION=true
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Optional fixed overrides. Defaults to https://api.${WEB_DOMAIN}/auth/discord/callback and https://${WEB_DOMAIN}/register
DISCORD_OAUTH_CALLBACK_URL=
DISCORD_OAUTH_REGISTRATION_URL=
DISCORD_MIN_ACCOUNT_AGE_DAYS=7
DISCORD_OAUTH_STATE_TTL_SECONDS=600
DISCORD_OAUTH_GRANT_TTL_SECONDS=600
# Required when Discord registration is enabled. Use an independent random secret of at least 32 bytes and keep it stable.
REGISTRATION_IDENTITY_SECRET=
# Optional comma-separated exact-domain allowlist. Defaults to major established email providers.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,msn.com,proton.me,protonmail.com,pm.me,yahoo.com,ymail.com,icloud.com,me.com,mac.com,fastmail.com,tuta.com,tutanota.com,tutamail.com,keemail.me,zoho.com,zohomail.com,aol.com,gmx.com,gmx.net,gmx.de,mail.com,hey.com

# Optional comma-separated CIDRs for reverse proxies allowed to supply X-Forwarded-For.
TRUSTED_PROXY_NETWORKS=

# Optional: Port number for the web application to listen on. Defaults to 443 if not set
SUNRISE_PORT=

# Optional: Whether to use Cloudflare headers for geolocation
USE_CLOUDFLARE_HEADERS_FOR_GEOLOCATION=false 

# Observatory settings (Beatmap Mirror manager)

# Required: The host address of the observatory service
OBSERVATORY_HOST=localhost
# Required: The port number of the observatory service
OBSERVATORY_PORT=3333
# Optional: API key for the observatory service to avoid rate limiting
OBSERVATORY_API_KEY=

# Database services

# Required: The host address of the MySQL database
MYSQL_HOST=localhost
# Required: The port number of the MySQL database
MYSQL_PORT=3306
# Required: The username for the MySQL database
MYSQL_USER=sunshine
# Required: The password for the MySQL database
MYSQL_PASSWORD=root
# Required: The database name of the MySQL database
MYSQL_DATABASE=sunrise

# Required: The host address of the Hangfire database
HANGFIRE_HOST=localhost
# Required: The port number of the Hangfire database
HANGFIRE_PORT=3306
# Required: The username for the Hangfire database
HANGFIRE_USER=sunshine
# Required: The password for the Hangfire database
HANGFIRE_PASSWORD=root

# Required: The host address of the Redis server
REDIS_HOST=localhost
# Required: The port number of the Redis server
REDIS_PORT=6379

# Telemetry services

# Optional: The host address of the Tempo service
TEMPO_HOST=localhost
# Optional: The port number of the Tempo service
TEMPO_PORT=4317

# Optional: The host address of the Loki service
LOKI_HOST=localhost
# Optional: The port number of the Loki service
LOKI_PORT=3100

########################################################
# Don't forget to edit appsettings.*.json config files #
########################################################
